// prisma/schema.prisma

// Configuração do gerador - isso cria o Prisma Client
generator client {
  provider = "prisma-client-js"
}

// Configuração da fonte de dados - de onde vêm os dados
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Lê do arquivo .env
}

// Modelo de veículos detectados pelo sistema
model Vehicle {
  id            Int      @id @default(autoincrement())
  plate         String   @db.VarChar(20)
  type          String   @db.VarChar(50)
  detectionTime DateTime @map("detection_time")
  confidence    Decimal  @db.Decimal(5, 2)
  imageUrl      String   @map("image_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("vehicles")
}
